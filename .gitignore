# Unity generated directories
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/
MemoryCaptures/

# Unity generated IDE/solution files
unity/*.csproj
unity/*.sln
unity/*.unityproj
unity/*.booproj
unity/*.svd
unity/*.pdb
unity/*.mdb
unity/*.opendb
unity/*.VC.db
unity/*.pidb
unity/Assets/AssetStoreTools*

# Catalog JSON staged by MopedSim.Editor.CliBuild before player builds (source of truth: data/catalogs/)
unity/Assets/StreamingAssets/Catalogs/
unity/Assets/StreamingAssets/Catalogs.meta
unity/Assets/StreamingAssets.meta

# IDE & Editor files
.vs/
.idea/
.vscode/
*.suo
*.user
*.userprefs

# .NET build & test outputs (src/*.csproj redirect bin/obj here so Unity UPM never imports stray .dlls)
artifacts/
bin/
obj/
logs/
TestResults/
*.nupkg

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

# Blender backup files
*.blend1
*.blend2

# OS & temporary files
.DS_Store
*.tmp
*.swp
*~
