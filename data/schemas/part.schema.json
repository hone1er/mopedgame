{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mopedgame.local/schemas/part.schema.json",
  "title": "MopedPartDefinition",
  "description": "Schema for an individual part, spare, tool, consumable, or garage station item in data/catalogs/parts.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "description",
    "category",
    "compatibleInterfaces",
    "has3dMesh",
    "meshAssetPath",
    "assetClass",
    "requiredSockets",
    "massKg",
    "priceUsd",
    "toolRollSlots",
    "stats"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[A-Za-z0-9_]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "Frame",
        "Fork",
        "Crankcase",
        "Cylinder",
        "CylinderHead",
        "Piston",
        "SparkPlug",
        "Intake",
        "Carburetor",
        "MainJet",
        "PilotJet",
        "AirFilter",
        "FuelTank",
        "Petcock",
        "FuelLine",
        "FuelFilter",
        "Exhaust",
        "Ignition",
        "Drivetrain",
        "VariatorRoller",
        "DriveBelt",
        "Sprocket",
        "DriveChain",
        "Wheel",
        "RearShock",
        "Handlebar",
        "Seat",
        "Headlight",
        "CargoRack",
        "Fender",
        "Brake",
        "Cable",
        "Gasket",
        "PremixOil",
        "Tool",
        "Spare",
        "GarageStation"
      ]
    },
    "compatibleInterfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "has3dMesh": {
      "type": "boolean"
    },
    "meshAssetPath": {
      "type": ["string", "null"],
      "pattern": "^Models/.*\\.glb$"
    },
    "assetClass": {
      "type": "string",
      "enum": ["Small", "Major", "Garage", "None"]
    },
    "requiredSockets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(SOCKET|BOLT)_[A-Z0-9_]+$"
      }
    },
    "massKg": {
      "type": "number",
      "minimum": 0
    },
    "priceUsd": {
      "type": "number",
      "minimum": 0
    },
    "toolRollSlots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "stats": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
