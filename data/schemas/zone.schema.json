{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mopedgame.local/schemas/zone.schema.json",
  "title": "BayAreaZoneDefinition",
  "description": "Schema for additive SF/Oakland Bay Area riding zones in data/catalogs/zones.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sceneName",
    "displayName",
    "description",
    "ambientAirDensity",
    "ambientTempCelsius",
    "maxGradePercent",
    "headwindMps",
    "fogDensity",
    "hasMuniRails",
    "primarySurfaces",
    "towFeeUsd",
    "connectedZones",
    "landmarks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^Zone_[A-Za-z0-9_]+$"
    },
    "sceneName": {
      "type": "string",
      "pattern": "^Zone_[A-Za-z0-9_]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "ambientAirDensity": {
      "type": "number",
      "minimum": 0.7,
      "maximum": 1.3
    },
    "ambientTempCelsius": {
      "type": "number",
      "minimum": -5,
      "maximum": 50
    },
    "maxGradePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 35
    },
    "headwindMps": {
      "type": "number",
      "minimum": 0,
      "maximum": 30
    },
    "fogDensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "hasMuniRails": {
      "type": "boolean"
    },
    "primarySurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "DryAsphalt",
          "PatchedPotholeAsphalt",
          "WetAsphalt",
          "SteelRailTrack",
          "GravelShoulder"
        ]
      }
    },
    "towFeeUsd": {
      "type": "number",
      "minimum": 0
    },
    "connectedZones": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^Zone_[A-Za-z0-9_]+$"
      }
    },
    "landmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "landmarkType", "position"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "landmarkType": {
            "type": "string",
            "enum": [
              "Garage",
              "Shop",
              "PlugChopStrip",
              "ClimbStart",
              "Summit",
              "Hub",
              "HazardZone"
            ]
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "z"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "z": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
